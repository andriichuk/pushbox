{
    "name": "andriichuk/pushbox",
    "description": "Laravel developer tool: preview FCM push payloads from notifications in the browser—Mailbook-style registry (add, to, category, variants, locales), optional DB rollback, and gated test sends.",
    "keywords": [
        "laravel",
        "laravel-package",
        "notifications",
        "fcm",
        "firebase-cloud-messaging",
        "push-notifications",
        "preview",
        "developer-tools",
        "mailbook",
        "pushbox",
        "testing"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Serhii Andriichuk",
            "email": "andriichuk29@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/notifications": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/log": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0",
        "laravel-notification-channels/fcm": "^6.2"
    },
    "suggest": {
        "laravel-notification-channels/fcm": "Preview notifications that implement toFcm() with FcmMessage (Firebase / FCM)."
    },
    "autoload": {
        "psr-4": {
            "Andriichuk\\Pushbox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Andriichuk\\Pushbox\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Andriichuk\\Pushbox\\PushboxServiceProvider"
            ],
            "aliases": {
                "Pushbox": "Andriichuk\\Pushbox\\Facades\\Pushbox"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "analyse": "phpstan analyse",
        "test": "phpunit",
        "lint": "pint",
        "lint:check": "pint --test"
    },
    "archive": {
        "exclude": [
            "/.github",
            "/tests",
            "/scripts",
            "/build",
            "/node_modules",
            "/package.json",
            "/package-lock.json",
            "/phpunit.xml",
            "/phpstan.neon.dist",
            "/vendor",
            "/.phpunit.cache",
            "/test-results",
            "/playwright-report"
        ]
    }
}
